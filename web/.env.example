# 复制为 web/.env 后，替换所有 CHANGE_ME 值。web/.env 已被仓库忽略。
JC_WEB_ADMIN_PASSWORD=CHANGE_ME_USE_AT_LEAST_12_CHARACTERS

# 分别运行 `openssl rand -base64 32` 生成，两个值不能相同。
JC_WEB_SESSION_SECRET=CHANGE_ME_BASE64_32_BYTES
JC_WEB_CREDENTIAL_KEY=CHANGE_ME_BASE64_32_BYTES

JC_WEB_DATABASE_PATH=./data/web/control-plane.db
JC_WEB_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
JC_WEB_SESSION_TTL_MS=28800000
JC_WEB_BIND_HOST=127.0.0.1
JC_WEB_BIND_PORT=8790
NODE_ENV=development
